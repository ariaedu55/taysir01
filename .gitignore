# Configuration privée de chaque environnement
/config/*.local.php
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# État du site, fichiers téléversés et exports WordPress
/storage/**/*
!/storage/**/
!/storage/**/.gitkeep
!/storage/.htaccess
/storage/exports/

# Sauvegardes, journaux et fichiers d’éditeur
*.sql
!/database/migrations/*.sql
# Retours arrière des migrations (docs/gestion-phase-1.md, 1B bis)
!/database/rollback/*.sql
*.sql.gz
*.log
*.bak
*.tmp
*.swp
.DS_Store
Thumbs.db
/.idea/
/.vscode/
/.codex/
/.agents/
/.aws/

# Anciens PNG remplacés par leur version WebP (docs/optimisation-images.md),
# illisibles sous Windows (droits d’un autre outil) : à supprimer à la main.
/public/assets/images/brand/logo-navy.png
/public/assets/images/brand/logo-white.png
/public/assets/images/destinations/ca.png
/public/assets/images/destinations/fr.png
/public/assets/images/destinations/gb.png
/public/assets/images/destinations/ma.png
/public/assets/images/destinations/sn.png
/public/assets/images/destinations/tn.png
/public/assets/images/destinations/tr.png

# Configuration serveur propre au VPS (copiée depuis deploy/)
/deploy/*.local

# Ancienne application GAOV (encore en ligne) : inventaires et sécurité, gardés en local, jamais dans ce dépôt public
/docs/gaov-*.md
/docs/gestion-admin-existant.md
