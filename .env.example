# Configuration privée de chaque environnement. Copier en .env (jamais versionné) et compléter.
# Voir docs/assistant-ia.md.

# Assistant IA (DeepSeek) : clé sur https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# deepseek-flash (rapide, économique) ou deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
# 1 pour afficher l'assistant sur le site, 0 pour le masquer
ASSISTANT_ENABLED=1
# 1 pour un flux simulé (tests sans crédit DeepSeek)
ASSISTANT_MOCK=0
# Réservation directe : laisser à 0 tant que les disponibilités et le SMTP ne sont pas opérationnels.
AGENDA_RESERVATION_DIRECTE=0
